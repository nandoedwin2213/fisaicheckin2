# Base de datos (PostgreSQL; Decimal y enums nativos no funcionan en SQLite)
DATABASE_URL="postgresql://fisai:fisai@localhost:5433/fisai_checkin?schema=public"

# Clave que usa FISAI Flow (recepción) para llamar a /checkin/manual y a la API de administración
STAFF_API_KEY="cambia-esta-clave-de-recepcion"

PORT=3000

# Ventana anti doble lectura, en segundos
DUPLICATE_WINDOW_SECONDS=60
