// FISAI — Check-in por tarjeta RFID
// La tarjeta es SOLO un identificador: nunca guarda saldo ni datos clínicos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  REHAB
  SARCO_FORCE
  EVALUACION
}

// Cómo cobra un equipo: una sesión del paquete, un precio fijo en créditos,
// o créditos por cada minuto encendido.
enum BillingMode {
  SESIONES
  CREDITOS
  MINUTOS
}

enum AttendanceResult {
  OK
  SIN_PAQUETE
  PAQUETE_VENCIDO
  SIN_CREDITOS
  TARJETA_DESCONOCIDA
  TARJETA_SIN_PACIENTE
  TARJETA_INACTIVA
  DUPLICADO
  PACIENTE_DESCONOCIDO
  EQUIPO_INACTIVO
}

model Patient {
  id        String   @id @default(uuid())
  cedula    String   @unique
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards      Card[]
  packages   PatientPackage[]
  attendance Attendance[]
  usages     Usage[]
  recharges  Recharge[]
}

model Card {
  id        String    @id @default(uuid())
  uid       String    @unique // UID hex en mayúsculas, ej. "A1B2C3D4"
  activa    Boolean   @default(true)
  patientId String?
  patient   Patient?  @relation(fields: [patientId], references: [id])
  issuedAt  DateTime  @default(now())
  revokedAt DateTime?

  attendance Attendance[]

  @@index([patientId])
}

model Package {
  id           String      @id @default(uuid())
  nombre       String
  sesiones     Int         @default(0)
  creditos     Decimal     @default(0) @db.Decimal(10, 2)
  vigenciaDias Int
  precio       Decimal     @db.Decimal(10, 2)
  serviceType  ServiceType
  activo       Boolean     @default(true)

  patientPackages PatientPackage[]
}

model PatientPackage {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id])
  packageId         String
  package           Package  @relation(fields: [packageId], references: [id])
  sesionesRestantes Int
  creditosRestantes Decimal  @default(0) @db.Decimal(10, 2)
  compradoEn        DateTime @default(now())
  venceEn           DateTime

  attendance Attendance[]
  usages     Usage[]
  recharges  Recharge[]

  @@index([patientId, venceEn])
}

// Sillón de masaje, caminadora, equipo de recuperación… Define la tarifa y cuánto
// tiempo debe cerrar el relé el terminal que lo controla.
model Equipment {
  id               String      @id @default(uuid())
  nombre           String
  serviceType      ServiceType
  billingMode      BillingMode
  // Créditos por uso (CREDITOS) o por minuto (MINUTOS). Ignorado en SESIONES.
  costo            Decimal     @default(0) @db.Decimal(10, 2)
  // Segundos que se activa el relé; en MINUTOS es además el tope de un uso.
  duracionSegundos Int         @default(0)
  activo           Boolean     @default(true)
  createdAt        DateTime    @default(now())

  terminals Terminal[]
  usages    Usage[]
}

// Un uso abierto de un equipo por minutos: se cobra al cerrarlo.
model Usage {
  id               String          @id @default(uuid())
  attendanceId     String          @unique
  attendance       Attendance      @relation(fields: [attendanceId], references: [id])
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id])
  terminalId       String
  terminal         Terminal        @relation(fields: [terminalId], references: [id])
  equipmentId      String
  equipment        Equipment       @relation(fields: [equipmentId], references: [id])
  patientPackageId String?
  patientPackage   PatientPackage? @relation(fields: [patientPackageId], references: [id])
  inicioEn         DateTime        @default(now())
  finEn            DateTime?
  segundos         Int?
  creditosCobrados Decimal         @default(0) @db.Decimal(10, 2)
  // true cuando el terminal nunca reportó el fin y se cerró con el tope del equipo.
  cerradoPorTope   Boolean         @default(false)

  @@index([patientId, inicioEn])
  @@index([terminalId, finEn])
}

// Recarga hecha en caja: crea el paquete/monedero y deja la huella de quién cobró.
model Recharge {
  id               String         @id @default(uuid())
  patientId        String
  patient          Patient        @relation(fields: [patientId], references: [id])
  patientPackageId String
  patientPackage   PatientPackage @relation(fields: [patientPackageId], references: [id])
  sesiones         Int
  creditos         Decimal        @db.Decimal(10, 2)
  monto            Decimal        @db.Decimal(10, 2)
  registradoPor    String?
  createdAt        DateTime       @default(now())

  @@index([patientId, createdAt])
}

// Un ESP32 físico. Se guarda solo el hash de la apiKey; el texto plano vive en el firmware.
model Terminal {
  id          String      @id @default(uuid())
  nombre      String
  serviceType ServiceType
  apiKeyHash  String      @unique
  activo      Boolean     @default(true)
  ultimoVisto DateTime?
  createdAt   DateTime    @default(now())
  // Equipo que activa este terminal. Sin equipo se comporta como control de acceso
  // por sesiones sobre su serviceType.
  equipmentId String?
  equipment   Equipment?  @relation(fields: [equipmentId], references: [id])

  attendance Attendance[]
  usages     Usage[]
}

// Cada lectura queda registrada, sea aceptada o no. Es la fuente de reportería.
model Attendance {
  id               String           @id @default(uuid())
  cardId           String?
  card             Card?            @relation(fields: [cardId], references: [id])
  patientId        String?
  patient          Patient?         @relation(fields: [patientId], references: [id])
  terminalId       String
  terminal         Terminal         @relation(fields: [terminalId], references: [id])
  patientPackageId String?
  patientPackage   PatientPackage?  @relation(fields: [patientPackageId], references: [id])
  uidLeido         String? // null cuando el registro es manual por cédula
  resultado        AttendanceResult
  manual           Boolean          @default(false)
  registradoPor    String? // usuario de recepción que hizo el registro manual
  createdAt        DateTime         @default(now())

  usage Usage?

  @@index([terminalId, createdAt])
  @@index([patientId, createdAt])
  @@index([cardId, createdAt])
}
